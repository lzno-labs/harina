# Copy to .env (never committed) or export these variables. No real values here.
# Public address people use to open harina. Passkeys are bound to this hostname.
HARINA_ORIGIN=http://localhost:8787
PORT=8787
HOST=127.0.0.1
# SQLite file. Back it up like any other file.
HARINA_DB=./data/harina.sqlite
# One-time code needed to create the first passkey. If empty, harina prints one at startup.
HARINA_SETUP_TOKEN=
# Build identifier shown by GET /health.
LZNO_CORE_SHA=
# MCP and OAuth (docs/adr/0004-oauth-and-mcp.md). "off" disables Client ID Metadata Documents.
HARINA_OAUTH_CIMD=on
# Extra browser origins allowed to call /mcp, comma separated (rarely needed).
HARINA_MCP_ORIGINS=
# Time zone for month boundaries in assistant answers.
HARINA_TZ=America/Costa_Rica
# Who can create an account: "closed" (default: only the first person, with the setup code; later
# people use their own instance) or "open" (anyone; limited per IP and by HARINA_MAX_USERS).
HARINA_SIGNUP=closed
HARINA_MAX_USERS=1000
# Privacy notice and terms (https URLs) shown when someone creates an account. Empty: hidden.
HARINA_PRIVACY_URL=
HARINA_TERMS_URL=
# iPhone apps allowed to use this server's passkeys (docs/adr/0007-passkeys-in-the-app.md), comma
# separated TEAMID.bundle.id. Served at /.well-known/apple-app-site-association. Empty: 404.
HARINA_APPLE_APP_IDS=
