// SPDX-License-Identifier: MPL-2.0
// Build settings for anyone building harina. Signing is per person: put your team and bundle id
// in Config/Signing.xcconfig (not committed in the open repo), for example:
//   DEVELOPMENT_TEAM = ABCDE12345
//   HARINA_BUNDLE_ID = com.yourname.harina
HARINA_BUNDLE_ID = org.example.harina
CODE_SIGN_STYLE = Automatic
// Info.plist text shown by iOS before the first Face ID prompt (Spanish, the app's language).
HARINA_FACE_ID_TEXT = Harina usa Face ID para que solo tú veas tus finanzas.
// iCloud link of a ready-made capture shortcut built for this bundle id (see AutomationGuide.swift).
// Empty by default: the app shows the manual steps. Write "https:/$()/" because // starts a comment.
HARINA_SHORTCUT_URL =
#include? "Signing.xcconfig"
